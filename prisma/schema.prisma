// MongoDB — aplicar no cluster: npm run prisma:push

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id       String @id @default(uuid()) @map("_id")
  name     String
  email    String @unique
  password String 

  mlAccessToken     String?
  mlRefreshToken    String?
  
  mlTokenExpiresAt  DateTime?
  
  mlUserId          String?

  items Item[]

  @@index([mlUserId])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Item {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  mlItemId     String   @unique
  title        String
  price        Float
  availableQty Int
  status       String
  active       Boolean  @default(true) 
  thumbnail    String?
  categoryId   String?

  userId String
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("items")
}
