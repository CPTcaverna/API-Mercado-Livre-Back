PORT=3000
NODE_ENV=development
JWT_SECRET=
# URL exata do front (sem barra no final). Vários domínios: separar por vírgula.
# Produção (front e API em domínios diferentes): NODE_ENV=production + HTTPS nos dois.
CORS_ORIGIN=http://localhost:5173
# Se o host não definir NODE_ENV=production, use COOKIE_CROSS_SITE=true no deploy.
# COOKIE_CROSS_SITE=true
DATABASE_URL=
ML_CLIENT_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=http://localhost:5173/auth/ml/callback
# OAuth Mercado Livre — credenciais do app em https://developers.mercadolivre.com.br/
# ML_AUTH_URL=https://auth.mercadolivre.com.br/authorization

# Webhooks — URL pública cadastrada no painel do app ML:
# Tópicos obrigatórios: items, items_prices (mudança de preço), orders_v2 (vendas/estoque)
# Ex.: https://SEU_DOMINIO/webhooks/mercadolivre
# ML_WEBHOOK_PUBLIC_URL=
